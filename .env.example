# Copy to .env.local for local development.

# App: leave empty to use the offline demo; point at an API to use the real backend.
# EXPO_PUBLIC_API_URL=http://localhost:3000/api

# API (npm run api:dev, db:migrate, db:seed). On Vercel, the Neon integration sets it.
# DATABASE_URL=postgres://user:password@host/db?sslmode=require

# Optional. Signs sessions; derived from DATABASE_URL when not set.
# BETTER_AUTH_SECRET=
